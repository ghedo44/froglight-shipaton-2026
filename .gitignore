apps/native/src-tauri/gen/*
!apps/native/src-tauri/gen/apple/
!apps/native/src-tauri/gen/apple/**
.env.*
*.env
credentials.json
*.pem
*.key
.credentials

.nx/polygraph

firebase-debug.log

# Reference-only third-party BlockNote tree (MPL-2.0 core, GPL xl-*); never imported into first-party sources.
BlockNote/

