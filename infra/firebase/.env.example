# Local developer environment template (plan1 §43–§44).
#
# Copy to `.env` (git-ignored) for local scripts. Values here are public
# client identifiers, NOT secrets — still restrict them in the Firebase
# console (API restrictions) as Firebase recommends.
#
# This file is NOT read by `apps/native`: the native app reads its own
# `apps/native/.env` through Vite (`import.meta.env`). Keep the
# `VITE_*` names below in sync with `apps/native/.env.example`, but set
# native values in `apps/native/.env`.
#
# Secrets (RevenueCat webhook shared secret, service-account keys, App
# Store Connect keys) NEVER belong in this file or the repository:
# use Firebase Secret Manager / GitHub Actions secrets (see README).

# Emulator project used by `pnpm test:emulators` (demo- prefix = test mode).
FIREBASE_PROJECT_ID=demo-froglight-sync-test

# Public Firebase web config for a dev project (Firebase console >
# Project settings > Your apps > Web app). Leave empty for local-only
# development: the app boots and local vaults keep working (plan1 §44).
VITE_FROGLIGHT_FIREBASE_API_KEY=
VITE_FROGLIGHT_FIREBASE_AUTH_DOMAIN=
VITE_FROGLIGHT_FIREBASE_PROJECT_ID=
VITE_FROGLIGHT_FIREBASE_STORAGE_BUCKET=
VITE_FROGLIGHT_FIREBASE_APP_ID=

# Public RevenueCat SDK key (test_... / appl_...). Secret keys never
# enter the repo. For the native app the canonical location is
# `apps/native/.env` as `VITE_FROGLIGHT_REVENUECAT_PUBLIC_KEY` (read via
# Vite `import.meta.env` and forwarded at runtime through the
# `froglight-purchases` `configure` IPC command); this line exists here
# only to keep local-script env names aligned, not as a read path.
VITE_FROGLIGHT_REVENUECAT_PUBLIC_KEY=
