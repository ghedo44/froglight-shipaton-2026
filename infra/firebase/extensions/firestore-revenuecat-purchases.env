# RevenueCat Firebase Extension instance configuration (plan1 §41).
#
# This file is the source-controlled half of the extensions manifest: the
# instance ID (`firestore-revenuecat-purchases`) matches the `extensions`
# block in `../firebase.json`, which pins the extension version
# (`revenuecat/firestore-revenuecat-purchases@0.1.18`).
#
# Only NON-SECRET parameters live here. The webhook shared secret is set
# through Secret Manager and never committed (plan1 §43):
#
#   firebase ext:secret:set REVENUECAT_SHARED_SECRET --project <project-id>
#
# (or Firebase console > Extensions > firestore-revenuecat-purchases >
# Reconfigure.) Deploy with `firebase deploy --only extensions`.

# Cloud Functions region. Match your Firestore database location (see README).
LOCATION=us-central1
# Write active entitlements into the `revenueCatEntitlements` Auth custom
# claim. REQUIRED for Froglight Pro authorization (plan1 §14): Security
# Rules trust this server-issued claim, never client purchase state.
SET_CUSTOM_CLAIMS=ENABLED
# Firestore event/customer collections stay DISABLED (empty = skip).
# Froglight needs only the Auth custom claims plus its own small sync
# control-plane docs (plan1 §42): fewer writes, less attack surface.
REVENUECAT_EVENTS_COLLECTION=
REVENUECAT_CUSTOMERS_COLLECTION=
