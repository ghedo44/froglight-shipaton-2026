{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "references": [
    {
      "path": "../ui/tsconfig.lib.json"
    },
    {
      "path": "../editor-blockpage/tsconfig.lib.json"
    },
    {
      "path": "../editor-whiteboard/tsconfig.lib.json"
    },
    {
      "path": "../sdk/tsconfig.lib.json"
    },
    {
      "path": "../plugin-platform/tsconfig.lib.json"
    },
    {
      "path": "../runtime/tsconfig.lib.json"
    },
    {
      "path": "../foundation/tsconfig.lib.json"
    }
  ],
  "exclude": [
    "vite.config.ts",
    "vitest.config.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
