{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "lib": ["es2022", "dom", "dom.iterable"],
    "declaration": true,
    "emitDeclarationOnly": false
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.spec.*", "**/*.test.*"],
  "references": [
    {
      "path": "../runtime/tsconfig.lib.json"
    },
    {
      "path": "../foundation/tsconfig.lib.json"
    }
  ]
}
