{
  "name": "@froglight/web",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "description": "PWA host — browser providers over the shared Froglight workbench",
  "nx": {
    "name": "web",
    "tags": [
      "layer:app",
      "platform:web",
      "authority:trusted",
      "domain:workspace"
    ],
    "targets": {
      "typecheck": {
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@froglight/application": "workspace:*",
    "@froglight/editor-blockpage": "workspace:*",
    "@froglight/editor-codemirror": "workspace:*",
    "@froglight/editor-ink": "workspace:*",
    "@froglight/editor-notebook": "workspace:*",
    "@froglight/editor-whiteboard": "workspace:*",
    "@froglight/foundation": "workspace:*",
    "@froglight/index-sqlite": "workspace:*",
    "@froglight/plugin-platform": "workspace:*",
    "@froglight/provider-latexjs": "workspace:*",
    "@froglight/provider-firebase": "workspace:*",
    "@froglight/provider-opfs": "workspace:*",
    "@froglight/provider-pdf-lib": "workspace:*",
    "@froglight/provider-pdfjs": "workspace:*",
    "@froglight/runtime": "workspace:*",
    "@froglight/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~6.0.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0"
  }
}
